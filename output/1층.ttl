@prefix bot: <https://w3id.org/bot#> .
@prefix fran: <https://example.org/fran#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix inst: <https://example.org/fran/inst#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fran:Column a owl:Class ;
    rdfs:subClassOf bot:Element .

fran:RoomCluster a owl:Class ;
    rdfs:label "문으로 이어진 공간군(세대 아님)"@ko ;
    rdfs:subClassOf bot:Space .

fran:accessibleDesign a owl:DatatypeProperty .

fran:areaM2 a owl:DatatypeProperty .

fran:clearWidthM a owl:DatatypeProperty .

fran:depthMM a owl:DatatypeProperty ;
    rdfs:domain fran:Beam .

fran:doubleLoadedCorridor a owl:DatatypeProperty .

fran:dwellingCount a owl:DatatypeProperty ;
    rdfs:domain fran:DwellingUnit ;
    rdfs:range xsd:integer .

fran:exterior a owl:DatatypeProperty ;
    rdfs:domain fran:Wall ;
    rdfs:range xsd:boolean .

fran:fixtureType a owl:DatatypeProperty .

fran:roomIndex a owl:DatatypeProperty ;
    rdfs:label "도면 내 방 순번(재인식 시 바뀔 수 있음)"@ko ;
    rdfs:domain bot:Space ;
    rdfs:range xsd:integer .

fran:stairTravelDistanceM a owl:DatatypeProperty .

fran:structural a owl:DatatypeProperty ;
    rdfs:domain fran:Wall ;
    rdfs:range xsd:boolean .

fran:verticalContinuation a owl:ObjectProperty .

