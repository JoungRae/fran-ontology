@prefix bot: <https://w3id.org/bot#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fran: <https://example.org/fran#> .
@prefix inst: <https://example.org/fran/inst#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fran:aboutSystem a owl:ObjectProperty ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range fran:System .

fran:action a owl:DatatypeProperty ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range xsd:string .

fran:appliedPolicy a owl:ObjectProperty ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range fran:PlacementPolicy .

fran:appliedRule a owl:ObjectProperty ;
    rdfs:label "이 판정을 실제로 결정한 규칙"@ko ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range fran:LegalRule .

fran:basis a owl:ObjectProperty ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range fran:Basis .

fran:confidence a owl:DatatypeProperty ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range xsd:string .

fran:floorContext a owl:DatatypeProperty ;
    rdfs:domain bot:Storey ;
    rdfs:range xsd:string .

fran:key a owl:DatatypeProperty ;
    rdfs:domain fran:PolicyEntry ;
    rdfs:range xsd:string .

fran:legalNode a owl:DatatypeProperty ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range xsd:string .

fran:needsReview a owl:DatatypeProperty ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range xsd:boolean .

fran:omittableBasis a owl:DatatypeProperty ;
    rdfs:range xsd:string .

fran:omittableRule a owl:ObjectProperty ;
    rdfs:label "생략 가능 근거이나 적용하지 않은 규칙(후보)"@ko ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range fran:LegalRule .

fran:order a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

fran:placementPolicy a owl:ObjectProperty ;
    rdfs:domain bot:Storey ;
    rdfs:range fran:PlacementPolicy .

fran:policyEntry a owl:ObjectProperty ;
    rdfs:domain fran:PlacementPolicy ;
    rdfs:range fran:PolicyEntry .

fran:radiusMM a owl:DatatypeProperty ;
    rdfs:label "이 실에 적용되는 헤드 수평거리(mm)"@ko ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range xsd:decimal .

fran:reason a owl:DatatypeProperty ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range xsd:string .

fran:rule a owl:ObjectProperty ;
    rdfs:domain fran:Basis ;
    rdfs:range fran:LegalRule .

fran:source a owl:DatatypeProperty ;
    rdfs:domain fran:RuleVerdict ;
    rdfs:range xsd:string .

fran:value a owl:DatatypeProperty ;
    rdfs:domain fran:PolicyEntry ;
    rdfs:range xsd:string .

fran:verdict a owl:ObjectProperty ;
    rdfs:domain bot:Space ;
    rdfs:range fran:RuleVerdict .

inst:Storey_지하1층_pit fran:floorContext "{\"용도\": \"아파트\", \"층\": \"지하1층\", \"세대있음\": false, \"건물사실\": {\"_설명\": \"설계 가정 — 확인된 값으로 간주하고 판정할 것\", \"지역\": \"서울특별시 강남구\", \"용도\": \"아파트\", \"동수\": 10, \"층수_지상\": 23, \"층수_지하\": 2, \"구조\": \"내화구조\", \"세대있음\": false, \"무대부\": false, \"특수가연물_저장취급\": false, \"랙크식창고\": false, \"전기차충전구역\": false, \"천장기울기_10분의1초과\": false}}"@ko ;
    fran:placementPolicy inst:Policy_지하1층_pit .

