# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. .env 는 git에 커밋되지 않습니다.

# layer_classify.py (GPT 레이어 분류)용 — 리포트 자체의 AI 어시스턴트와는 무관합니다.
# 리포트의 AI 어시스턴트 키는 브라우저에서 직접 입력합니다(서버에 저장 안 함).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# fetch_head_checks.py 등 법령 DB(PostgreSQL, cons_law) 조회용 — 없어도 나머지 파이프라인은 동작합니다.
PG_DSN=postgresql://user:password@host:5432/dbname
